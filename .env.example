# Ключ Anthropic. Либо это, либо вход через `ant auth login` —
# SDK подхватит и то и другое.
ANTHROPIC_API_KEY=

# Курс доллара для пересчёта себестоимости в рубли.
# Это вход, а не факт: поставьте свой.
TOLMACH_USD_RUB=92

# Чем переводить. Пусто — берутся значения по умолчанию
# из src/config.ts: claude-opus-5 и claude-haiku-4-5.
TOLMACH_MODEL_STRONG=
TOLMACH_MODEL_FAST=
