{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd .. && npm install",
  "functions": {
    "app/api/translate/route.ts": {
      "maxDuration": 300
    },
    "app/api/ahead/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/ahead",
      "schedule": "0 3 * * *"
    }
  ]
}
